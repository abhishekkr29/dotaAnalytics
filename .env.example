# Server-side default Anthropic key. Users can override per-account by saving their
# own key in the web UI's Settings page (BYO).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenDota Premium API key (optional). Get one at https://www.opendota.com/api-keys
# When set, every OpenDota call is tagged with ?api_key=... for 5× the rate limit
# (~10000 calls/day vs 2000 free) + parse-queue priority (5-30min/match vs hours).
# Leave blank to use the free tier.
OPENDOTA_API_KEY=

# JWT secret for the auth↔web handshake. Any random string is fine; rotate to log
# every existing session out.
JWT_SECRET=change-me-to-a-long-random-string

# Fernet key for encrypting BYO Anthropic keys at rest. Generate one with:
#   docker compose run --rm app python -m app.crypto gen
FERNET_KEY=change-me-base64-32bytes

# Per-user daily cost cap (cents) when using the server key. BYO bypasses.
DAILY_COST_CAP_CENTS=25

# Steam OpenID realm — must be a substring of the return_to URL. For local dev
# leave as below; in production set to your public auth host (https://...).
STEAM_OPENID_REALM=http://localhost:8502
AUTH_PUBLIC_URL=http://localhost:8502
WEB_PUBLIC_URL=http://localhost:8501
